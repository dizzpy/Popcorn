{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The minimum the main window needs",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-internal-toggle-maximize",
    "allow-app-info",
    "allow-get-settings",
    "allow-pick-media-folder",
    "allow-finish-onboarding",
    "allow-set-tmdb-key",
    "allow-test-tmdb-key",
    "allow-rescan",
    "allow-list-titles",
    "allow-get-title",
    "allow-continue-watching",
    "allow-search-library",
    "allow-search-episodes",
    "allow-set-watched",
    "allow-set-title-watched",
    "allow-reveal-file",
    "allow-open-external",
    "allow-tmdb-search",
    "allow-fix-match",
    "allow-refresh-title",
    "allow-refresh-all-metadata",
    "allow-clear-image-cache",
    "allow-player-open",
    "allow-player-close",
    "allow-player-toggle-pause",
    "allow-player-seek",
    "allow-player-set-volume",
    "allow-player-toggle-mute",
    "allow-player-set-audio",
    "allow-player-set-subtitle",
    "allow-player-add-subtitle",
    "allow-player-toggle-fullscreen",
    "allow-player-exit-fullscreen",
    "allow-player-set-subtitle-lift"
  ]
}
